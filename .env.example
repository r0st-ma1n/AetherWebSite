# DB_ENGINE=django.db.backends.sqlite3   # override for local tests without Postgres
DB_NAME=aether
DB_USER=aether
DB_PASSWORD=aether
DB_HOST=localhost
DB_PORT=5432

# Generate a real secret for production: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Note: docker compose reads this file too and expands $VAR — escape any literal "$" as "$$".
SECRET_KEY=django-insecure-0c9e=vd6lo9(u3v@l$$7eh@^6n$$hj9-c5#$$bkva($$58)bxpk^y7
DEBUG=True
# Comma-separated list of allowed hostnames, e.g. aetheride.ru,www.aetheride.ru
# Set DEBUG=False and fill this in for production (see docker-compose.prod.yml).
ALLOWED_HOSTS=

# Email (defaults to printing to console; set SMTP values for real delivery)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
